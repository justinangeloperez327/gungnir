[unix_http_server]
file=@ROOT@/run/supervisor.sock
chmod=0600

[supervisord]
logfile=@ROOT@/logs/supervisord.log
logfile_maxbytes=10MB
logfile_backups=3
pidfile=@ROOT@/run/supervisord.pid
childlogdir=@ROOT@/logs
umask=0077

[rpcinterface:supervisor]
supervisor.rpcinterface_factory=supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://@ROOT@/run/supervisor.sock

[program:redis]
command=@REDIS_SERVER@ @ROOT@/config/redis.conf
directory=@ROOT@/data/redis
priority=10
autostart=true
autorestart=true
startsecs=1
startretries=3
stopsignal=TERM
stopwaitsecs=15
stopasgroup=true
killasgroup=true
stdout_logfile=@ROOT@/logs/redis.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
redirect_stderr=true

[program:web-a]
command=@ROOT@/current/.gungnir/build/app
directory=@ROOT@/current
priority=20
environment=GUNGNIR_DEPLOY_ENV="@ROOT@/config/deployment.env",APP_PORT="@WEB_A@",GUNGNIR_DEPLOY_INSTANCE="web-a"
@APPLICATION_OPTIONS@

[program:web-b]
command=@ROOT@/current/.gungnir/build/app
directory=@ROOT@/current
priority=20
environment=GUNGNIR_DEPLOY_ENV="@ROOT@/config/deployment.env",APP_PORT="@WEB_B@",GUNGNIR_DEPLOY_INSTANCE="web-b"
@APPLICATION_OPTIONS@

[program:worker]
command=@ROOT@/current/.gungnir/build/background queue:work
directory=@ROOT@/current
priority=30
environment=GUNGNIR_DEPLOY_ENV="@ROOT@/config/deployment.env",GUNGNIR_DEPLOY_INSTANCE="worker"
@APPLICATION_OPTIONS@

[program:scheduler]
command=@ROOT@/current/.gungnir/build/background schedule:work
directory=@ROOT@/current
priority=40
environment=GUNGNIR_DEPLOY_ENV="@ROOT@/config/deployment.env",GUNGNIR_DEPLOY_INSTANCE="scheduler"
@APPLICATION_OPTIONS@

[group:application]
programs=web-a,web-b,worker,scheduler
priority=20

[program:proxy]
command=@NGINX@ -p @ROOT@/run/nginx/ -c @ROOT@/config/nginx.conf -g "daemon off;"
priority=30
autostart=true
autorestart=true
startsecs=1
startretries=3
stopsignal=QUIT
stopwaitsecs=15
stopasgroup=true
killasgroup=true
stdout_logfile=@ROOT@/logs/proxy.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
redirect_stderr=true
