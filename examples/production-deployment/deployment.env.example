# Literal KEY=value entries. Generate each secret independently with openssl rand -hex 32.
APP_ENV=production
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PUBLIC_HOST=api.example.com
APP_API_TOKEN=
APP_NAMESPACE=production-example
DB_CONNECTION=sqlite
DB_DATABASE=/srv/gungnir/data/application.sqlite
DB_POOL_SIZE=1
DB_POOL_ACQUIRE_TIMEOUT_MS=1000
DEPLOY_DATA_DIR=/srv/gungnir/data
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional: install the OTLP adapter before enabling these settings.
OTLP_ENDPOINT=
OTLP_CA_FILE=
OTLP_AUTHORIZATION=
# Optional bounded asynchronous work delay; normally zero.
REQUEST_WORK_DELAY_MS=0
