model User {
    fillable = ["name", "active", "settings", "password"];
    hidden = ["password"];
    casts = {"active": "bool", "settings": "json"};
    timestamps = true;
    softDeletes = true;

    profile() { return hasOne<Profile>(); }
    posts() { return hasMany<Post>(); }
    roles() { return belongsToMany<Role>(); }
    rolesByName() { return belongsToMany<Role>(pivotTable: "role_name_user", relatedPivotKey: "role_name", relatedKey: "name"); }
    comments() { return hasManyThrough<Comment, Post>(); }
    firstComment() { return hasOneThrough<Comment, Post>(); }
}

model Post {
    fillable = ["user_id", "title"];
    author() { return belongsTo<User>("user_id"); }
    comments() { return hasMany<Comment>(); }
}

model Profile { fillable = ["user_id", "display_name"]; }
model Role {
    fillable = ["name"];
    users() { return belongsToMany<User>(); }
}
model Comment { fillable = ["post_id", "body"]; }

model Tenant {
    primaryKey = "uuid";
    incrementing = false;
    fillable = ["uuid", "name"];
    casts = {"uuid": "string"};
    projects() { return hasMany<Project>(foreignKey: "owner_uuid"); }
}
model Project {
    fillable = ["owner_uuid", "name"];
    owner() { return belongsTo<Tenant>("owner_uuid"); }
}
model Node {
    int? parent_id;
    fillable = ["parent_id", "name"];
    children() { return hasMany<Node>("parent_id"); }
    parent() { return belongsTo<Node>(); }
}

