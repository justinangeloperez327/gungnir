        Table::create("role_user", (table) => { table.integer("role_id"); table.integer("user_id"); });
        Table::create("role_name_user", (table) => { table.string("role_name"); table.integer("user_id"); });
        Table::create("comments", (table) => { table.id(); table.integer("post_id"); table.string("body"); });
        Table::create("tenants", (table) => { table.string("uuid").primary(); table.string("name"); });
