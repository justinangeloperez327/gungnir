function int add(int left, int right = 2) { return left + right; }
function string greeting(string who) { return 'Hello ' + who; }
event Created { int id; string title; }
listener RecordCreated { handle(Created event) { const id = event.id; } }
job Ping { int id; handle() { const copy = id; } }
mail Welcome { string username; subject() { return 'Welcome ' + username; } html() { return '<b>Hello</b>'; } }
migration CreateUsers { up() { Table::create('users', (table) => { table.id(); table.string('name'); }); } down() { Table::dropIfExists('users'); } }
model User { table = 'users'; fillable = ['name', 'active']; hidden = ['secret']; casts = { active: 'bool' }; }
function List<int> doubled() { return [1,2,3].map((item) => item * 2); }
policy UserPolicy { view(User actor, User resource) { return actor.id == resource.id; } }
notification Greeting { string title; via(User recipient) { return ['mail', 'database']; } toDatabase(User recipient) { return { title: title }; } }
async function int later(int value) { return value + 1; }
async function int twice(int value) { const result = await later(value); return result * 2; }
function int named() { return add(right: 7, left: 3); }
function int nullable(int? value) { return value ?? 9; }
function int closure(int value) { const calculate = (int item) => { const local = item + value; return local; }; return calculate(4); }
function string unicode() { return '\u0041\u03a9'; }
function int separators() { return 1_024 + 0b10 + 0x10; }
async function void completed() { return; }
listener AsyncRecord { async handle(Created event) { await completed(); } }
job AsyncPing { int id; async handle() { await completed(); } }
function int guarded(int? value) { if (value != null) { return value + 1; } else { return 0; } }
async function int nested(int value) { return add(await later(value), 2); }
function Json absent() { return { item: null }; }
function int? emptyOptional() { return null; }
job InjectedPing { inject Tools tools; int id; handle() { const result = tools.number(); } }
controller Tools { int number() { return 3; } }
event Versioned { int version = 1; }
function int eventDefault() { const event = Versioned(); return event.version; }
function double floating() { return 2f + 1.5; }
function int minimum() { return -9223372036854775808; }
function string embedded() { return 'a\0b'; }
function Json lookup() { const value = { item: 'hello' }; return value['item']; }
function int loop() { let total = 0; for (let i = 0; i < 3; i++) { total += i; } return total; }

function int resetNullable(int? input) { let value = input; if (value != null) { value = null; } return value ?? 7; }
function int replaceNullable(int? input) { let value = input; if (value != null) { value = 12; } return value ?? 7; }
function int replaceWithOptional(int? input, int? replacement) { let value = input; if (value != null) { value = replacement; } return value ?? 7; }
function int incrementNullable(int? input) { let value = input; if (value != null) { value += 2; value++; return value; } return 0; }
function int mapKeyLength(Map<string,int> values) { let total = 0; for (key in values) { total += key.length(); } return total; }
function int temporaryMapKeyLength(Map<string,int> values) { for (key in true ? values : values) { return key.length(); } return 0; }
function int optionalMapKeyLength(Map<string,int>? values) { if (values != null) { let total = 0; for (key in values) { total += key.length(); } return total; } return 0; }
function int listSum(List<int> values) { let total = 0; for (value in values) { total += value; } return total; }
function int nestedMapKeyLength(Map<string,int> values) { let total = 0; for (key in values) { const run = () => { let length = 0; for (other in values) { length += key.length() + other.length(); } return length; }; total += run(); } return total; }
controller MutableCounter { int count; int increment() { count++; return count; } }
function int mutateCounter() { let counter = MutableCounter(1); counter.count = 4; return counter.increment(); }
function int readCapturedCounter() { let counter = MutableCounter(3); const run = () => counter.count; return run(); }
function int mutateLambdaLocal() { const run = () => { let counter = MutableCounter(1); counter.count++; return counter.increment(); }; return run(); }

function int flowStableBranch(int? input, bool flag) { let value = input; if (value == null) { return 0; } if (flag) { const other = 1; } return value; }
function int flowTerminatingBranch(int? input, bool reset) { let value = input; if (value == null) { return 0; } if (reset) { value = null; return 0; } return value; }
function int flowRecheck(int? input, bool reset) { let value = input; if (value == null) { return 0; } if (reset) { value = null; } if (value == null) { return 9; } return value; }
function int flowStableWhile(int? input) { let value = input; if (value == null) { return 0; } let total = 0; let i = 0; while (i < 3) { total += value; i++; } return total + value; }
function int flowStableFor(int? input) { let value = input; if (value == null) { return 0; } let total = 0; for (let i = 0; i < 3; i++) { total += value; } return total + value; }
function int flowStableEach(int? input) { let value = input; if (value == null) { return 0; } let total = 0; for (item in [1,2,3]) { total += value; } return total + value; }
function int flowGuardedWhile(int? input) { let value = input; let total = 0; while (value != null) { total += value; value = null; } return total; }
function int flowGuardedFor(int? input) { let value = input; let total = 0; for (let i = 0; value != null; i++) { total += value; value = null; } return total; }
function int flowGuardedEach(int? input, List<int> items) { let value = input; let total = 0; for (item in items) { if (value == null) { continue; } total += value; value = null; } return total; }
function int flowArrowIsolation(int? input) { let value = input; const read = () => { if (value == null) { return 0; } return value; }; const seen = read(); return (value ?? 9) + seen; }
function int flowCapturedValue(int? input) { let value = input; if (value == null) { return 0; } const read = () => value; value = null; return read(); }
function int flowShadowedFor(int? input) { let value = input; if (value == null) { return 0; } for (let value = 0; value < 2; value = value + 1) {} return value; }
function int flowShadowedBody(int? input) { let value = input; if (value == null) { return 0; } let i = 0; while (i < 2) { let value = 0; value = 2; i++; } return value; }
function int flowRepeatedGuard(int? input) { let value = input; if (value == null) { return 0; } if (null == value) { return 0; } return value; }

controller Home { public index(Request request) { return text(request.header('X-Name')); } private int helper() { return 2; } }
migration Helpers { up() { helper(); } down() {} private void helper() {} }

function void checkUser(Request request, User resource) { authorize(request, 'view', resource); }
notification WelcomeNotice { via(User recipient) { return ['mail']; } toMail(User recipient) { return Welcome('Ada'); } }
model Price { table = 'prices'; casts = { amount: 'decimal' }; }
function Decimal exactAmount() { return exactDecimal('12345678901234567890.123400'); }
function Json validatePayload(Request request) { return request.validate({ enabled: 'required|boolean', count: 'integer' }); }

middleware PassThrough {
    async handle(Request request, Next next) {
        return await next(request);
    }
}

model AuditRecord {
    table = 'audit_records';
    fillable = ['name'];
    timestamps = true;
    softDeletes = true;
}
