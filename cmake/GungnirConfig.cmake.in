@PACKAGE_INIT@

set(Gungnir_VERSION "@PROJECT_VERSION@")
set(Gungnir_RELEASE_VERSION "@GUNGNIR_VERSION_FULL@")
set(Gungnir_RELEASE_CHANNEL "@GUNGNIR_RELEASE_CHANNEL@")
set(Gungnir_VERSION_MAJOR "@PROJECT_VERSION_MAJOR@")
set(Gungnir_VERSION_MINOR "@PROJECT_VERSION_MINOR@")
set(Gungnir_VERSION_PATCH "@PROJECT_VERSION_PATCH@")
set(Gungnir_NATIVE_API_CONTRACT "1.0")
set(Gungnir_NATIVE_ABI_EPOCH "1")
set(Gungnir_SDK_PROFILE "@GUNGNIR_SDK_PROFILE@")
set(Gungnir_WITH_SQLITE "@GUNGNIR_WITH_SQLITE@")
set(Gungnir_WITH_PASSWORD "@GUNGNIR_WITH_PASSWORD@")
set(Gungnir_BUNDLED_APPLICATION_DEPENDENCIES "@GUNGNIR_APPLICATION_SDK@")

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if("@GUNGNIR_APPLICATION_SDK@" STREQUAL "ON")
    include("${CMAKE_CURRENT_LIST_DIR}/GungnirApplicationDependencies.cmake")
endif()
if("@GUNGNIR_WITH_S3@" STREQUAL "ON")
    find_dependency(CURL 7.75)
endif()
if("@GUNGNIR_WITH_SQLITE@" STREQUAL "ON" AND NOT "@GUNGNIR_APPLICATION_SDK@" STREQUAL "ON")
    find_dependency(SQLite3)
endif()
if("@GUNGNIR_WITH_PASSWORD@" STREQUAL "ON" AND NOT "@GUNGNIR_APPLICATION_SDK@" STREQUAL "ON" AND NOT "@GUNGNIR_WITH_TLS@" STREQUAL "ON")
    find_dependency(OpenSSL 3.0 COMPONENTS Crypto)
endif()

if("@GUNGNIR_WITH_MYSQL@" STREQUAL "ON")
    list(
        PREPEND
        CMAKE_MODULE_PATH
        "${CMAKE_CURRENT_LIST_DIR}/modules"
    )
    find_dependency(MariaDB)
endif()

if("@GUNGNIR_WITH_SQLSERVER@" STREQUAL "ON")
    find_dependency(ODBC)
endif()

if("@GUNGNIR_WITH_POSTGRESQL@" STREQUAL "ON")
    find_dependency(PostgreSQL)
endif()

if("@GUNGNIR_WITH_MONGODB@" STREQUAL "ON")
    find_dependency(mongoc 2.5.4 CONFIG)
endif()

if("@GUNGNIR_WITH_REDIS@" STREQUAL "ON")
    list(
        PREPEND
        CMAKE_MODULE_PATH
        "${CMAKE_CURRENT_LIST_DIR}/modules"
    )
    find_dependency(Hiredis)
endif()

if(
    "@GUNGNIR_WITH_SMTP@" STREQUAL "ON" OR
    "@GUNGNIR_WITH_OTLP@" STREQUAL "ON"
)
    find_dependency(CURL 7.56)
endif()

if("@GUNGNIR_WITH_TLS@" STREQUAL "ON")
    find_dependency(OpenSSL 3.0 COMPONENTS Crypto SSL)
endif()

if("@GUNGNIR_WITH_HTTP2@" STREQUAL "ON")
    list(
        PREPEND
        CMAKE_MODULE_PATH
        "${CMAKE_CURRENT_LIST_DIR}/modules"
    )
    find_dependency(Nghttp2)
endif()

include(
    "${CMAKE_CURRENT_LIST_DIR}/GungnirTargets.cmake"
)

check_required_components(Gungnir)
