#pragma once

#include <string_view>

#define GUNGNIR_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define GUNGNIR_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define GUNGNIR_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define GUNGNIR_VERSION_STRING "@GUNGNIR_VERSION_FULL@"
#define GUNGNIR_RELEASE_CHANNEL "@GUNGNIR_RELEASE_CHANNEL@"

#define GUNGNIR_NATIVE_API_CONTRACT_MAJOR 1
#define GUNGNIR_NATIVE_API_CONTRACT_MINOR 0
#define GUNGNIR_NATIVE_ABI_EPOCH 1

namespace gungnir {

inline constexpr int version_major =
    GUNGNIR_VERSION_MAJOR;

inline constexpr int version_minor =
    GUNGNIR_VERSION_MINOR;

inline constexpr int version_patch =
    GUNGNIR_VERSION_PATCH;

inline constexpr std::string_view version =
    GUNGNIR_VERSION_STRING;

inline constexpr std::string_view
    release_channel =
        GUNGNIR_RELEASE_CHANNEL;

// Native C++ source contract for the 1.x release line.
inline constexpr std::string_view
    native_api_contract_version = "1.0";

// ABI epoch 1 identifies the stable binary line. Compatibility also requires
// matching platforms, toolchains, runtime models and build features.
inline constexpr int native_abi_epoch =
    GUNGNIR_NATIVE_ABI_EPOCH;

} // namespace gungnir
